{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Web Bridge",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/fetch": {
      "post": {
        "summary": "Fetch",
        "operationId": "fetch_v1_fetch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FetchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BridgeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/extract": {
      "post": {
        "summary": "Extract",
        "operationId": "extract_v1_extract_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BridgeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/batch": {
      "post": {
        "summary": "Batch",
        "operationId": "batch_v1_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchRequest": {
        "properties": {
          "query": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "markdown"
            ],
            "title": "Format",
            "default": "json"
          },
          "max_content_length": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 100.0,
            "title": "Max Content Length",
            "default": 12000
          },
          "include_links": {
            "type": "boolean",
            "title": "Include Links",
            "default": true
          },
          "include_metadata": {
            "type": "boolean",
            "title": "Include Metadata",
            "default": true
          },
          "urls": {
            "items": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Urls"
          },
          "render": {
            "type": "string",
            "enum": [
              "http",
              "auto",
              "browser"
            ],
            "title": "Render",
            "default": "http"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "urls"
        ],
        "title": "BatchRequest"
      },
      "BridgeResponse": {
        "properties": {
          "request": {
            "additionalProperties": true,
            "type": "object",
            "title": "Request"
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          },
          "content": {
            "$ref": "#/components/schemas/Content"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array",
            "title": "Links"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          },
          "optimization": {
            "$ref": "#/components/schemas/Optimization"
          },
          "actions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Actions"
          }
        },
        "type": "object",
        "required": [
          "request",
          "page",
          "content",
          "links",
          "metadata",
          "optimization"
        ],
        "title": "BridgeResponse"
      },
      "Content": {
        "properties": {
          "main_text": {
            "type": "string",
            "title": "Main Text"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "type": "array",
            "title": "Sections"
          }
        },
        "type": "object",
        "required": [
          "main_text",
          "sections"
        ],
        "title": "Content"
      },
      "ExtractRequest": {
        "properties": {
          "query": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "markdown"
            ],
            "title": "Format",
            "default": "json"
          },
          "max_content_length": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 100.0,
            "title": "Max Content Length",
            "default": 12000
          },
          "include_links": {
            "type": "boolean",
            "title": "Include Links",
            "default": true
          },
          "include_metadata": {
            "type": "boolean",
            "title": "Include Metadata",
            "default": true
          },
          "html": {
            "type": "string",
            "maxLength": 2000000,
            "minLength": 1,
            "title": "Html"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "html"
        ],
        "title": "ExtractRequest"
      },
      "FetchRequest": {
        "properties": {
          "query": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "markdown"
            ],
            "title": "Format",
            "default": "json"
          },
          "max_content_length": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 100.0,
            "title": "Max Content Length",
            "default": 12000
          },
          "include_links": {
            "type": "boolean",
            "title": "Include Links",
            "default": true
          },
          "include_metadata": {
            "type": "boolean",
            "title": "Include Metadata",
            "default": true
          },
          "url": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Url"
          },
          "render": {
            "type": "string",
            "enum": [
              "http",
              "auto",
              "browser"
            ],
            "title": "Render",
            "default": "http"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "FetchRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Link": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "text",
          "url"
        ],
        "title": "Link"
      },
      "Optimization": {
        "properties": {
          "raw_bytes": {
            "type": "integer",
            "title": "Raw Bytes"
          },
          "raw_text_characters": {
            "type": "integer",
            "title": "Raw Text Characters"
          },
          "returned_characters": {
            "type": "integer",
            "title": "Returned Characters"
          },
          "reduction_percent": {
            "type": "number",
            "title": "Reduction Percent"
          },
          "estimated_raw_tokens": {
            "type": "integer",
            "title": "Estimated Raw Tokens"
          },
          "estimated_clean_tokens": {
            "type": "integer",
            "title": "Estimated Clean Tokens"
          },
          "estimated_returned_tokens": {
            "type": "integer",
            "title": "Estimated Returned Tokens"
          },
          "estimated_tokens_saved": {
            "type": "integer",
            "title": "Estimated Tokens Saved"
          },
          "token_reduction_percent": {
            "type": "number",
            "title": "Token Reduction Percent"
          }
        },
        "type": "object",
        "required": [
          "raw_bytes",
          "raw_text_characters",
          "returned_characters",
          "reduction_percent",
          "estimated_raw_tokens",
          "estimated_clean_tokens",
          "estimated_returned_tokens",
          "estimated_tokens_saved",
          "token_reduction_percent"
        ],
        "title": "Optimization"
      },
      "Page": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "default": ""
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "canonical_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Url"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          }
        },
        "type": "object",
        "title": "Page"
      },
      "Section": {
        "properties": {
          "heading": {
            "type": "string",
            "title": "Heading"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "relevance_score": {
            "type": "number",
            "title": "Relevance Score"
          }
        },
        "type": "object",
        "required": [
          "heading",
          "text",
          "relevance_score"
        ],
        "title": "Section"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}